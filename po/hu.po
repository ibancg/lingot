msgstr "Nincs kapcsolat a JACK hangkiszolgálóval"

#: ../src/lingot-audio-jack.c:90 ../src/lingot-audio-jack.c:194
msgid "Unable to connect to JACK server"
msgstr "Nem lehet kapcsolódni a JACK kiszolgálóhoz"

#: ../src/lingot-audio-jack.c:116
msgid "No more JACK ports available"
msgstr "Nincs több elérhető JACK-port"

#: ../src/lingot-audio-jack.c:226
msgid "Default Port"
msgstr "Alapértelmezett port"

#: ../src/lingot-audio-jack.c:294
msgid "Cannot activate client"
msgstr "Nem aktiválható a kliens"

#: ../src/lingot-audio-jack.c:300
